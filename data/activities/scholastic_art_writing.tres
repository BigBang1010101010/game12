[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 1: es el premio de artes y escritura con mayor peso reconocido del pais y lo juzgan artistas, no administradores.
;   Una Gold Medal nacional es dificil de fabricar, y por eso su peldano cima pide reconocimiento nacional.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Participante"
tier = 4
modificadores_atributo = {
&"habilidad_artistica": 5.00,
&"aptitud_verbal": 5.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Nivel escolar"
tier = 3
modificadores_atributo = {
&"habilidad_artistica": 6.00,
&"aptitud_verbal": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Nivel regional"
tier = 2
modificadores_atributo = {
&"habilidad_artistica": 8.00,
&"aptitud_verbal": 8.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Nivel nacional"
tier = 1
modificadores_atributo = {
&"habilidad_artistica": 12.00,
&"aptitud_verbal": 12.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"nacional"
}]

[resource]
script = ExtResource("1_act")
id = &"scholastic_art_writing"
nombre_display = "Scholastic Art & Writing"
descripcion = "Portafolio propio presentado a los Scholastic Awards."
categoria = &"artes"
tier_techo = 1
costo_horas_semana = 7
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"artes_comunicacion": 1.50
}
