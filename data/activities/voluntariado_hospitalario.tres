[gd_resource type="Resource" script_class="ActivityData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 3: es casi obligatorio para un aspirante a medicina y por eso mismo no distingue a nadie; lo que si distingue es la continuidad, que aqui se paga por el multiplicador de anios y no por el peldano.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Voluntario"
tier = 4
modificadores_atributo = {
&"impacto_comunitario": 5.00,
&"caracter": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Voluntario constante"
tier = 3
modificadores_atributo = {
&"impacto_comunitario": 6.00,
&"caracter": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}]

[resource]
script = ExtResource("1_act")
id = &"voluntariado_hospitalario"
nombre_display = "Voluntariado hospitalario"
descripcion = "Turnos regulares de voluntariado en un hospital."
categoria = &"medicina"
tier_techo = 3
costo_horas_semana = 5
niveles = [SubResource("Nivel0"), SubResource("Nivel1")]
carreras_afinidad = {
&"medicina": 1.45,
&"psicologia": 1.30
}
