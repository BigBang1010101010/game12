[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 2: el servicio generico es el relleno mas comun de la Common App; solo despega cuando hay impacto medible y anios, que es exactamente lo que exigen sus niveles altos.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Voluntario"
tier = 4
modificadores_atributo = {
&"impacto_comunitario": 4.0
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Voluntario constante"
tier = 3
modificadores_atributo = {
&"impacto_comunitario": 5.0,
&"red_social": 3.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Coordinador de programa"
tier = 2
modificadores_atributo = {
&"impacto_comunitario": 8.0,
&"liderazgo": 4.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[resource]
script = ExtResource("1_act")
id = &"voluntariado_comunitario"
nombre_display = "Voluntariado comunitario"
descripcion = "Servicio sostenido en una organización de la comunidad."
categoria = &"transversal"
tier_techo = 2
costo_horas_semana = 5
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"psicologia": 1.2,
&"medicina": 1.1,
&"ciencias_politicas": 1.1
}
