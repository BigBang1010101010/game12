[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 2: circuito real pero mucho mas pequeno que el de debate; excelente senal especifica para derecho.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Miembro del equipo"
tier = 4
modificadores_atributo = {
&"aptitud_verbal": 4.0,
&"rigor_academico": 3.0
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Abogado titular"
tier = 3
modificadores_atributo = {
&"aptitud_verbal": 6.0,
&"resiliencia": 3.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Capitán estatal"
tier = 2
modificadores_atributo = {
&"aptitud_verbal": 7.0,
&"liderazgo": 5.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[resource]
script = ExtResource("1_act")
id = &"mock_trial"
nombre_display = "Juicio simulado"
descripcion = "Equipo de juicio simulado con competencias estatales."
categoria = &"derecho_politica"
tier_techo = 2
costo_horas_semana = 7
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"derecho": 1.4,
&"ciencias_politicas": 1.2
}
