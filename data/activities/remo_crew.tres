[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Umbral REGIONAL: el caso clasico de alto retorno.
;   Los rosters son grandes, la demanda de las Ivies es constante y la base de competidores es pequena, asi que un nivel regional solido ya entra en el radar de un entrenador.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Miembro del equipo"
tier = 4
modificadores_atributo = {
&"logro_atletico": 5.00,
&"resiliencia": 3.00,
&"liderazgo": 3.00,
&"bienestar": 2.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Titular"
tier = 3
modificadores_atributo = {
&"logro_atletico": 6.00,
&"resiliencia": 4.00,
&"liderazgo": 4.00,
&"bienestar": 3.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Capitán / nivel escolar"
tier = 2
modificadores_atributo = {
&"logro_atletico": 8.00,
&"resiliencia": 6.00,
&"liderazgo": 6.00,
&"bienestar": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Nivel de reclutamiento (regional)"
tier = 1
modificadores_atributo = {
&"logro_atletico": 12.00,
&"resiliencia": 9.00,
&"liderazgo": 9.00,
&"bienestar": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}]

[resource]
script = ExtResource("1_act")
id = &"remo_crew"
nombre_display = "Remo (crew)"
descripcion = "Entrenamiento de remo y regatas de temporada."
categoria = &"deporte"
tier_techo = 1
costo_horas_semana = 18
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {}
es_deporte = true
umbral_reclutamiento = 2
academic_index_minimo = 176
