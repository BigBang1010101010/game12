[gd_resource type="Resource" script_class="ActivityData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 3 pese a costar 11 horas: es de las actividades que mas tiempo consumen y menos credenciales dejan fuera del ambito escolar.
;   Su valor real esta en el ensayo que permite escribir.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Miembro"
tier = 4
modificadores_atributo = {
&"habilidad_artistica": 3.00,
&"aptitud_verbal": 3.00,
&"red_social": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Miembro activo"
tier = 3
modificadores_atributo = {
&"habilidad_artistica": 4.00,
&"aptitud_verbal": 4.00,
&"red_social": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[resource]
script = ExtResource("1_act")
id = &"teatro"
nombre_display = "Teatro"
descripcion = "Producciones escolares y compañías juveniles."
categoria = &"artes"
tier_techo = 3
costo_horas_semana = 11
niveles = [SubResource("Nivel0"), SubResource("Nivel1")]
carreras_afinidad = {
&"artes_comunicacion": 1.40
}
