[gd_resource type="Resource" script_class="ActivityData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   BOOST UNIVERSAL: en el Common Data Set seccion C7 las ocho Ivies marcan 'work experience' como CONSIDERADO, ninguna lo sube a importante y ninguna lo baja a no considerado.
;   Por eso esta actividad no declara NINGUNA afinidad de carrera y en su lugar declara boost_universal 1.0, que el calculador suma como un termino aparte, igual en las ocho escuelas.
;   El trabajo no habla de vocacion, habla de responsabilidad.
;   Techo tier 3: pesa de verdad, pero no existe un campeonato nacional de trabajar.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Empleado"
tier = 4
modificadores_atributo = {
&"resiliencia": 5.00,
&"gestion_tiempo": 5.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Empleado con antigüedad"
tier = 3
modificadores_atributo = {
&"resiliencia": 6.00,
&"gestion_tiempo": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}]

[resource]
script = ExtResource("1_act")
id = &"trabajo_remunerado"
nombre_display = "Trabajo remunerado"
descripcion = "Empleo real con horario, jefe y nómina."
categoria = &"transversal"
tier_techo = 3
costo_horas_semana = 15
niveles = [SubResource("Nivel0"), SubResource("Nivel1")]
carreras_afinidad = {}
boost_universal = 1.00
