[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 1 y 24 horas semanales: el circuito TOC es, en tiempo real, un trabajo de medio tiempo, y esa es la decision de diseno mas importante de esta actividad.
;   Ocupa dos tercios del presupuesto semanal, asi que elegirla es renunciar a casi todo lo demas, que es exactamente lo que le pasa a quien lo hace en serio.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Participante"
tier = 4
modificadores_atributo = {
&"aptitud_verbal": 6.00,
&"resiliencia": 3.00,
&"curiosidad_intelectual": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Nivel escolar"
tier = 3
modificadores_atributo = {
&"aptitud_verbal": 8.00,
&"resiliencia": 4.00,
&"curiosidad_intelectual": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Nivel regional"
tier = 2
modificadores_atributo = {
&"aptitud_verbal": 10.00,
&"resiliencia": 6.00,
&"curiosidad_intelectual": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Nivel nacional"
tier = 1
modificadores_atributo = {
&"aptitud_verbal": 15.00,
&"resiliencia": 9.00,
&"curiosidad_intelectual": 9.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"nacional"
}]

[resource]
script = ExtResource("1_act")
id = &"debate_toc"
nombre_display = "Debate (circuito TOC)"
descripcion = "Circuito nacional de debate con aspiración al Tournament of Champions."
categoria = &"derecho_politica"
tier_techo = 1
costo_horas_semana = 24
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"derecho": 1.50,
&"ciencias_politicas": 1.45,
&"negocios": 1.20
}
