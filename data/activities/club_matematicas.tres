[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 1: la jerarquia de la competencia matematica es nacional, publica y no se puede inflar, asi que una medalla se lee sin contexto.
;   La escalera avanza por reconocimiento externo y no por cargo: aqui no hay presidencias que valgan, hay resultados.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Participante"
tier = 4
modificadores_atributo = {
&"aptitud_cuantitativa": 5.00,
&"rigor_academico": 3.00,
&"curiosidad_intelectual": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Nivel escolar"
tier = 3
modificadores_atributo = {
&"aptitud_cuantitativa": 6.00,
&"rigor_academico": 4.00,
&"curiosidad_intelectual": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Nivel regional"
tier = 2
modificadores_atributo = {
&"aptitud_cuantitativa": 8.00,
&"rigor_academico": 6.00,
&"curiosidad_intelectual": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Nivel nacional"
tier = 1
modificadores_atributo = {
&"aptitud_cuantitativa": 12.00,
&"rigor_academico": 9.00,
&"curiosidad_intelectual": 9.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"nacional"
}]

[resource]
script = ExtResource("1_act")
id = &"club_matematicas"
nombre_display = "Club de matemáticas"
descripcion = "Entrenamiento y competencia matemática, del club escolar a las olimpiadas nacionales."
categoria = &"stem"
tier_techo = 1
costo_horas_semana = 8
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"ingenieria": 1.30,
&"ciencias_computacion": 1.35,
&"economia": 1.30
}
