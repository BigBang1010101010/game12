[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 1: fundar algo que sobrevive sin ti es la definicion practica de tier 1, y por eso su nivel cima pide fundador, anios e impacto a la vez.
;   Es tambien la actividad mas facil de inflar, de ahi el impacto medible obligatorio.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Idea y primeros voluntarios"
tier = 4
modificadores_atributo = {
&"liderazgo": 4.0,
&"impacto_comunitario": 3.0
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Organización establecida"
tier = 3
modificadores_atributo = {
&"liderazgo": 5.0,
&"impacto_comunitario": 5.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"fundador"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Equipo y programa propio"
tier = 2
modificadores_atributo = {
&"liderazgo": 7.0,
&"impacto_comunitario": 7.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"fundador"
}, {
"palanca": "impacto_medible",
"valor": 150.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Alcance regional"
tier = 1
modificadores_atributo = {
&"liderazgo": 10.0,
&"impacto_comunitario": 11.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "rol_liderazgo",
"valor": &"fundador"
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}, {
"palanca": "impacto_medible",
"valor": 500.0
}]

[resource]
script = ExtResource("1_act")
id = &"organizacion_propia"
nombre_display = "Organización fundada por el jugador"
descripcion = "Iniciativa propia con estructura, equipo y beneficiarios."
categoria = &"transversal"
tier_techo = 1
costo_horas_semana = 10
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"negocios": 1.3,
&"ciencias_politicas": 1.2,
&"psicologia": 1.1
}
