[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 1: los ingresos verificables son de lo poco que un adolescente puede mostrar y que ninguna plantilla explica.
;   Es tambien lo mas facil de inflar, por eso su escalera pide impacto medible en TODOS sus peldanos, empezando en 100 y terminando en 1000.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Idea y primeros pasos"
tier = 4
modificadores_atributo = {
&"liderazgo": 6.00,
&"resiliencia": 5.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Funcionando"
tier = 3
modificadores_atributo = {
&"liderazgo": 8.00,
&"resiliencia": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "impacto_medible",
"valor": 100.0
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Con equipo propio"
tier = 2
modificadores_atributo = {
&"liderazgo": 10.00,
&"resiliencia": 8.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"fundador"
}, {
"palanca": "impacto_medible",
"valor": 400.0
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Alcance regional"
tier = 1
modificadores_atributo = {
&"liderazgo": 15.00,
&"resiliencia": 12.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "rol_liderazgo",
"valor": &"fundador"
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}, {
"palanca": "impacto_medible",
"valor": 1000.0
}]

[resource]
script = ExtResource("1_act")
id = &"emprendimiento_real"
nombre_display = "Emprendimiento real"
descripcion = "Negocio propio con clientes, ingresos y cuentas."
categoria = &"negocios"
tier_techo = 1
costo_horas_semana = 15
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"negocios": 1.50,
&"finanzas": 1.30
}
