[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Umbral ESTATAL, mas bajo que el del baloncesto o el futbol: el beisbol universitario tiene rosters grandes, el circuito de scouting de secundaria es denso y las Ivies reclutan de forma sostenida en el noreste
;   Es tambien el deporte con las estadisticas mas ricas del catalogo - cuatro categorias, dos de bateo y dos de pitcheo - que es justo lo que lo hace el mejor banco de pruebas del sistema estadistico.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Miembro del equipo"
tier = 4
modificadores_atributo = {
&"logro_atletico": 5.00,
&"resiliencia": 3.00,
&"liderazgo": 3.00,
&"bienestar": 2.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Titular"
tier = 3
modificadores_atributo = {
&"logro_atletico": 6.00,
&"resiliencia": 4.00,
&"liderazgo": 4.00,
&"bienestar": 3.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Capitán / nivel regional"
tier = 2
modificadores_atributo = {
&"logro_atletico": 8.00,
&"resiliencia": 6.00,
&"liderazgo": 6.00,
&"bienestar": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Nivel de reclutamiento (estatal)"
tier = 1
modificadores_atributo = {
&"logro_atletico": 12.00,
&"resiliencia": 9.00,
&"liderazgo": 9.00,
&"bienestar": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"estatal"
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}]

[resource]
script = ExtResource("1_act")
id = &"beisbol"
nombre_display = "Béisbol"
descripcion = "Temporada de béisbol con estadísticas de bateo y de pitcheo."
categoria = &"deporte"
tier_techo = 1
costo_horas_semana = 16
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {}
es_deporte = true
umbral_reclutamiento = 3
academic_index_minimo = 176
