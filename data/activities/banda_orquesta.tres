[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 2: el circuito de audiciones es jerarquico y verificable, pero el tier 1 del area queda para el portafolio individual premiado, que es lo que un comite de artes evalua de verdad.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Participante"
tier = 4
modificadores_atributo = {
&"habilidad_artistica": 5.00,
&"gestion_tiempo": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Nivel escolar"
tier = 3
modificadores_atributo = {
&"habilidad_artistica": 6.00,
&"gestion_tiempo": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Nivel regional"
tier = 2
modificadores_atributo = {
&"habilidad_artistica": 8.00,
&"gestion_tiempo": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}]

[resource]
script = ExtResource("1_act")
id = &"banda_orquesta"
nombre_display = "Banda / orquesta"
descripcion = "Ensayos, audiciones y presentaciones con el conjunto."
categoria = &"artes"
tier_techo = 2
costo_horas_semana = 9
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"artes_comunicacion": 1.45
}
