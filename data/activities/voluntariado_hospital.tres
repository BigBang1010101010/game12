[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 2: es practicamente obligatorio para un aspirante a medicina y por eso mismo no distingue; lo que distingue es la continuidad, que aqui se paga via el multiplicador de anios.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Voluntario"
tier = 4
modificadores_atributo = {
&"impacto_comunitario": 4.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Voluntario de planta"
tier = 3
modificadores_atributo = {
&"impacto_comunitario": 5.00,
&"resiliencia": 3.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Coordinador de voluntarios"
tier = 2
modificadores_atributo = {
&"impacto_comunitario": 7.00,
&"liderazgo": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[resource]
script = ExtResource("1_act")
id = &"voluntariado_hospital"
nombre_display = "Voluntariado hospitalario"
descripcion = "Horas de voluntariado en un hospital o clínica comunitaria."
categoria = &"medicina"
tier_techo = 2
costo_horas_semana = 6
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"medicina": 1.50,
&"psicologia": 1.30
}
