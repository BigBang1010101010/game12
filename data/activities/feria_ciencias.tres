[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 2: la feria es una excelente puerta de entrada a la investigacion, pero sin mentor ni publicacion se lee como proyecto escolar.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Participante"
tier = 4
modificadores_atributo = {
&"aptitud_cientifica": 4.0,
&"curiosidad_intelectual": 3.0
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Finalista escolar"
tier = 3
modificadores_atributo = {
&"aptitud_cientifica": 5.0,
&"aptitud_investigacion": 4.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Premio regional"
tier = 2
modificadores_atributo = {
&"aptitud_investigacion": 6.0,
&"rigor_academico": 4.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[resource]
script = ExtResource("1_act")
id = &"feria_ciencias"
nombre_display = "Feria de ciencias"
descripcion = "Proyecto experimental propio presentado en ferias escolares y regionales."
categoria = &"stem"
tier_techo = 2
costo_horas_semana = 5
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"medicina": 1.2,
&"ingenieria": 1.2,
&"ciencias_computacion": 1.1
}
