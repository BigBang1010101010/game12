[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 2: los hackathons escolares rara vez se leen como logro nacional, aunque el portafolio si sostiene una candidatura fuerte a computacion.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Miembro"
tier = 4
modificadores_atributo = {
&"aptitud_cuantitativa": 4.00,
&"curiosidad_intelectual": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Proyecto publicado"
tier = 3
modificadores_atributo = {
&"aptitud_cuantitativa": 5.00,
&"profundidad_extracurricular": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Organizador de hackathon"
tier = 2
modificadores_atributo = {
&"aptitud_cuantitativa": 7.00,
&"liderazgo": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[resource]
script = ExtResource("1_act")
id = &"club_programacion"
nombre_display = "Club de programación"
descripcion = "Desarrollo de software, hackathons y competencias de programación."
categoria = &"stem"
tier_techo = 2
costo_horas_semana = 6
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"ciencias_computacion": 1.45,
&"ingenieria": 1.25
}
