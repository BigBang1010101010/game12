[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 1 SOLO por su ultimo peldano, que exige el rol de fundador ademas de tres anios y 500 de impacto: el voluntariado normal es tier 2, y fundar la ONG es lo unico que lo sube.
;   Esa es la lectura literal del pedido, y queda expresada en las palancas, no en una excepcion de codigo.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Voluntario"
tier = 4
modificadores_atributo = {
&"impacto_comunitario": 5.00,
&"caracter": 5.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Voluntario constante"
tier = 3
modificadores_atributo = {
&"impacto_comunitario": 6.00,
&"caracter": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Coordinador"
tier = 2
modificadores_atributo = {
&"impacto_comunitario": 8.00,
&"caracter": 8.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "impacto_medible",
"valor": 150.0
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Fundador de organización"
tier = 1
modificadores_atributo = {
&"impacto_comunitario": 12.00,
&"caracter": 12.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "rol_liderazgo",
"valor": &"fundador"
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}, {
"palanca": "impacto_medible",
"valor": 500.0
}]

[resource]
script = ExtResource("1_act")
id = &"voluntariado_sostenido"
nombre_display = "Voluntariado sostenido"
descripcion = "Servicio continuado en una organización, con posibilidad de fundar la propia."
categoria = &"transversal"
tier_techo = 1
costo_horas_semana = 6
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"ingenieria": 1.15,
&"ciencias_computacion": 1.15,
&"economia": 1.15,
&"medicina": 1.15,
&"psicologia": 1.15,
&"derecho": 1.15,
&"ciencias_politicas": 1.15,
&"negocios": 1.15,
&"finanzas": 1.15,
&"artes_comunicacion": 1.15
}
