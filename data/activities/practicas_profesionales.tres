[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 2: la practica en secundaria casi siempre se consigue por red de contactos, y los comites lo saben; vale por lo que el estudiante produjo, no por donde estuvo.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Practicante"
tier = 4
modificadores_atributo = {
&"gestion_tiempo": 4.00,
&"profundidad_extracurricular": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Proyecto propio"
tier = 3
modificadores_atributo = {
&"gestion_tiempo": 5.00,
&"red_social": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Proyecto adoptado por la empresa"
tier = 2
modificadores_atributo = {
&"profundidad_extracurricular": 7.00,
&"liderazgo": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[resource]
script = ExtResource("1_act")
id = &"practicas_profesionales"
nombre_display = "Prácticas profesionales"
descripcion = "Internado en una empresa u organización real."
categoria = &"negocios"
tier_techo = 2
costo_horas_semana = 10
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"negocios": 1.30,
&"finanzas": 1.30,
&"economia": 1.20,
&"ingenieria": 1.15
}
