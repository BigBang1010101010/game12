[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 2: el rating es objetivo y publico, pero salvo titulos altos el ajedrez se lee como talento personal, no como impacto.
;   La afinidad con 'matematicas' del pedido se traduce a economia y computacion, que son las carreras cuantitativas que este catalogo tiene.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Participante"
tier = 4
modificadores_atributo = {
&"aptitud_cuantitativa": 3.00,
&"resiliencia": 3.00,
&"gestion_tiempo": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Nivel escolar"
tier = 3
modificadores_atributo = {
&"aptitud_cuantitativa": 4.00,
&"resiliencia": 4.00,
&"gestion_tiempo": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Nivel regional"
tier = 2
modificadores_atributo = {
&"aptitud_cuantitativa": 6.00,
&"resiliencia": 6.00,
&"gestion_tiempo": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}]

[resource]
script = ExtResource("1_act")
id = &"ajedrez_competitivo"
nombre_display = "Ajedrez competitivo"
descripcion = "Torneos con rating oficial."
categoria = &"stem"
tier_techo = 2
costo_horas_semana = 6
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"ciencias_computacion": 1.20,
&"economia": 1.20,
&"finanzas": 1.25
}
