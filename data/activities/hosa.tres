[gd_resource type="Resource" script_class="ActivityData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 3: el club por si solo no sostiene nada, pero es la puerta de entrada al voluntariado y a las certificaciones, y da senal temprana de interes.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Miembro"
tier = 4
modificadores_atributo = {
&"aptitud_cientifica": 3.00,
&"liderazgo": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Miembro activo"
tier = 3
modificadores_atributo = {
&"aptitud_cientifica": 4.00,
&"liderazgo": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[resource]
script = ExtResource("1_act")
id = &"hosa"
nombre_display = "HOSA"
descripcion = "Capítulo HOSA de profesiones de la salud."
categoria = &"medicina"
tier_techo = 3
costo_horas_semana = 5
niveles = [SubResource("Nivel0"), SubResource("Nivel1")]
carreras_afinidad = {
&"medicina": 1.35
}
