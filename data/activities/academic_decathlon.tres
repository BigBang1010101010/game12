[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 2.
;   Es la unica actividad academica que paga a lo ancho en vez de a lo hondo: rigor alto y un poco de cada aptitud, porque compite en diez materias simultaneas.
;   Sin afinidad de carrera a proposito: no apunta a ningun campo, apunta a la disciplina de estudiar.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Participante"
tier = 4
modificadores_atributo = {
&"rigor_academico": 5.00,
&"aptitud_verbal": 2.00,
&"aptitud_cuantitativa": 2.00,
&"aptitud_cientifica": 2.00,
&"curiosidad_intelectual": 2.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Nivel escolar"
tier = 3
modificadores_atributo = {
&"rigor_academico": 6.00,
&"aptitud_verbal": 3.00,
&"aptitud_cuantitativa": 3.00,
&"aptitud_cientifica": 3.00,
&"curiosidad_intelectual": 3.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Nivel regional"
tier = 2
modificadores_atributo = {
&"rigor_academico": 8.00,
&"aptitud_verbal": 4.00,
&"aptitud_cuantitativa": 4.00,
&"aptitud_cientifica": 4.00,
&"curiosidad_intelectual": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "reconocimiento_externo",
"valor": &"regional"
}]

[resource]
script = ExtResource("1_act")
id = &"academic_decathlon"
nombre_display = "Academic Decathlon"
descripcion = "Competencia por equipos sobre diez materias a la vez."
categoria = &"transversal"
tier_techo = 2
costo_horas_semana = 6
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {}
