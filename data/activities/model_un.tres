[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 2: es de las actividades mas comunes en aplicaciones competitivas, lo que la vuelve poco distintiva salvo por cargos de organizacion, que es justo lo que pide su peldano alto.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Miembro"
tier = 4
modificadores_atributo = {
&"aptitud_verbal": 5.00,
&"liderazgo": 3.00,
&"curiosidad_intelectual": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Miembro activo"
tier = 3
modificadores_atributo = {
&"aptitud_verbal": 6.00,
&"liderazgo": 4.00,
&"curiosidad_intelectual": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Oficial"
tier = 2
modificadores_atributo = {
&"aptitud_verbal": 8.00,
&"liderazgo": 6.00,
&"curiosidad_intelectual": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[resource]
script = ExtResource("1_act")
id = &"model_un"
nombre_display = "Modelo de Naciones Unidas"
descripcion = "Delegaciones y conferencias de simulación diplomática."
categoria = &"derecho_politica"
tier_techo = 2
costo_horas_semana = 8
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"ciencias_politicas": 1.45,
&"derecho": 1.25
}
