[gd_resource type="Resource" script_class="ActivityData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 3: el club solo no sostiene nada, pero abre la puerta al voluntariado y a la certificacion, y da senal de interes temprano.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Miembro"
tier = 4
modificadores_atributo = {
&"aptitud_cientifica": 3.0,
&"curiosidad_intelectual": 2.0
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Oficial del club"
tier = 3
modificadores_atributo = {
&"aptitud_cientifica": 4.0,
&"red_social": 3.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[resource]
script = ExtResource("1_act")
id = &"club_medicina"
nombre_display = "Club de ciencias de la salud"
descripcion = "Club escolar de exploración de carreras de la salud (tipo HOSA)."
categoria = &"medicina"
tier_techo = 3
costo_horas_semana = 4
niveles = [SubResource("Nivel0"), SubResource("Nivel1")]
carreras_afinidad = {
&"medicina": 1.4,
&"psicologia": 1.1
}
