[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 1: un negocio con ingresos verificables es de las pocas cosas que un adolescente puede mostrar y que ninguna plantilla explica.
;   El impacto medible son dolares o clientes, por eso el nivel cima lo exige.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Idea y primeros clientes"
tier = 4
modificadores_atributo = {
&"liderazgo": 4.0,
&"gestion_tiempo": 3.0
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Ingresos sostenidos"
tier = 3
modificadores_atributo = {
&"liderazgo": 5.0,
&"red_social": 4.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Equipo a cargo"
tier = 2
modificadores_atributo = {
&"liderazgo": 7.0,
&"gestion_tiempo": 6.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Negocio consolidado"
tier = 1
modificadores_atributo = {
&"liderazgo": 11.0,
&"impacto_comunitario": 7.0,
&"red_social": 6.0
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "rol_liderazgo",
"valor": &"presidente"
}, {
"palanca": "reconocimiento_externo",
"valor": &"estatal"
}, {
"palanca": "impacto_medible",
"valor": 400.0
}]

[resource]
script = ExtResource("1_act")
id = &"emprendimiento_propio"
nombre_display = "Emprendimiento propio"
descripcion = "Negocio propio con ingresos y clientes reales."
categoria = &"negocios"
tier_techo = 1
costo_horas_semana = 12
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"negocios": 1.5,
&"finanzas": 1.3,
&"economia": 1.2,
&"ciencias_computacion": 1.1
}
