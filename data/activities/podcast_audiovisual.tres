[gd_resource type="Resource" script_class="ActivityData" load_steps=5 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Techo tier 3: cualquiera puede empezar uno, que es justo lo que lo hace mala credencial y buena senal de iniciativa.
;   Escalera de emprendimiento porque lo unico que lo separa de un hobby es la audiencia, es decir, el impacto medible.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Idea y primeros pasos"
tier = 4
modificadores_atributo = {
&"habilidad_artistica": 3.00,
&"iniciativa": 5.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Funcionando"
tier = 3
modificadores_atributo = {
&"habilidad_artistica": 4.00,
&"iniciativa": 6.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "impacto_medible",
"valor": 100.0
}]

[resource]
script = ExtResource("1_act")
id = &"podcast_audiovisual"
nombre_display = "Podcast / proyecto audiovisual"
descripcion = "Proyecto propio de audio o video con publicación sostenida."
categoria = &"artes"
tier_techo = 3
costo_horas_semana = 6
niveles = [SubResource("Nivel0"), SubResource("Nivel1")]
carreras_afinidad = {
&"artes_comunicacion": 1.35
}
