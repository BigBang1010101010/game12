[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 1: el portafolio es evaluado por artistas, no por administradores, y un premio nacional de arte es una credencial dificil de fabricar.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Obra propia"
tier = 4
modificadores_atributo = {
&"habilidad_artistica": 5.00,
&"curiosidad_intelectual": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Exposición escolar"
tier = 3
modificadores_atributo = {
&"habilidad_artistica": 6.00,
&"profundidad_extracurricular": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Premio regional"
tier = 2
modificadores_atributo = {
&"habilidad_artistica": 8.00,
&"resiliencia": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Reconocimiento nacional"
tier = 1
modificadores_atributo = {
&"habilidad_artistica": 13.00,
&"profundidad_extracurricular": 8.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "rol_liderazgo",
"valor": &"presidente"
}, {
"palanca": "reconocimiento_externo",
"valor": &"estatal"
}, {
"palanca": "impacto_medible",
"valor": 400.0
}]

[resource]
script = ExtResource("1_act")
id = &"portafolio_artes_visuales"
nombre_display = "Portafolio de artes visuales"
descripcion = "Cuerpo de obra propio, exposiciones y concursos."
categoria = &"artes"
tier_techo = 1
costo_horas_semana = 10
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"artes_comunicacion": 1.50
}
