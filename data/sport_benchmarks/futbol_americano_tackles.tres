[gd_resource type="Resource" script_class="StatBenchmark" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/stat_benchmark.gd" id="1_ben"]

; De donde salen estos umbrales:
;   Cien tackles en una temporada de secundaria es el umbral que la prensa local usa para destacar a un linebacker; 130 lo pone entre los mejores del estado.

[resource]
script = ExtResource("1_ben")
id = &"futbol_americano_tackles"
categoria_id = &"futbol_americano_tackles"
bandas = [{
"valor": 40.0,
"reconocimiento": &"escolar"
}, {
"valor": 70.0,
"reconocimiento": &"regional"
}, {
"valor": 100.0,
"reconocimiento": &"estatal"
}, {
"valor": 130.0,
"reconocimiento": &"nacional"
}]
fuente = "Cien tackles en una temporada de secundaria es el umbral que la prensa local usa para destacar a un linebacker; 130 lo pone entre los mejores del estado."
