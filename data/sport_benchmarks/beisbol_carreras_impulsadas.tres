[gd_resource type="Resource" script_class="StatBenchmark" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/stat_benchmark.gd" id="1_ben"]

; De donde salen estos umbrales:
;   Las impulsadas dependen tanto del equipo como del bateador, asi que sus bandas son mas exigentes que las de jonrones: 35 en una temporada corta implica batear en el centro de una alineacion ganadora.

[resource]
script = ExtResource("1_ben")
id = &"beisbol_carreras_impulsadas"
categoria_id = &"beisbol_carreras_impulsadas"
bandas = [{
"valor": 15.0,
"reconocimiento": &"escolar"
}, {
"valor": 25.0,
"reconocimiento": &"regional"
}, {
"valor": 35.0,
"reconocimiento": &"estatal"
}, {
"valor": 50.0,
"reconocimiento": &"nacional"
}]
fuente = "Las impulsadas dependen tanto del equipo como del bateador, asi que sus bandas son mas exigentes que las de jonrones: 35 en una temporada corta implica batear en el centro de una alineacion ganadora."
