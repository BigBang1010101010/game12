[gd_resource type="Resource" script_class="StatBenchmark" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/stat_benchmark.gd" id="1_ben"]

; De donde salen estos umbrales:
;   Las asistencias se reparten mas que los goles: quince en una temporada implica ser el organizador del ataque de un equipo que gana mucho.

[resource]
script = ExtResource("1_ben")
id = &"futbol_soccer_asistencias"
categoria_id = &"futbol_soccer_asistencias"
bandas = [{
"valor": 5.0,
"reconocimiento": &"escolar"
}, {
"valor": 10.0,
"reconocimiento": &"regional"
}, {
"valor": 15.0,
"reconocimiento": &"estatal"
}, {
"valor": 22.0,
"reconocimiento": &"nacional"
}]
fuente = "Las asistencias se reparten mas que los goles: quince en una temporada implica ser el organizador del ataque de un equipo que gana mucho."
