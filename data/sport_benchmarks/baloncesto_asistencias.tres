[gd_resource type="Resource" script_class="StatBenchmark" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/stat_benchmark.gd" id="1_ben"]

; De donde salen estos umbrales:
;   Siete asistencias por partido en secundaria implica ser el creador de juego absoluto del equipo; nueve es una cifra que muy pocos bases sostienen una temporada entera.

[resource]
script = ExtResource("1_ben")
id = &"baloncesto_asistencias"
categoria_id = &"baloncesto_asistencias"
bandas = [{
"valor": 3.0,
"reconocimiento": &"escolar"
}, {
"valor": 5.0,
"reconocimiento": &"regional"
}, {
"valor": 7.0,
"reconocimiento": &"estatal"
}, {
"valor": 9.0,
"reconocimiento": &"nacional"
}]
fuente = "Siete asistencias por partido en secundaria implica ser el creador de juego absoluto del equipo; nueve es una cifra que muy pocos bases sostienen una temporada entera."
