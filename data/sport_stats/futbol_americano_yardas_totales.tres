[gd_resource type="Resource" script_class="SportStatCategory" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/sport_stat_category.gd" id="1_stat"]

; ESTADISTICA REAL DEL DEPORTE, no inventada para el juego.
;   Yardas de ataque acumuladas en la temporada (carrera mas recepcion).
;   Es LA estadistica de un jugador ofensivo de secundaria y la primera linea de cualquier ficha de reclutamiento.

[resource]
script = ExtResource("1_stat")
id = &"futbol_americano_yardas_totales"
deporte_id = &"futbol_americano"
nombre_display = "Yardas totales"
unidad = "yardas"
es_mejor_mayor = true
acumulativa = true
orden = 10
