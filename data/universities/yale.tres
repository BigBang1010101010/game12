[ext_resource type="Script" path="res://scripts/resources/university_data.gd" id="1_uni"]

; RAZONAMIENTO DE PESOS - Yale
; - perfil deliberadamente mas parejo que Harvard: mismo rigor exigido pero
;   liderazgo bastante mas bajo (0.75 vs 0.95) y artes mas altas.
; - solo un umbral (rigor 68): de las ocho es de las que menos castiga un
;   perfil disparejo, coherente con su fama de admitir personas "interesantes".
; - servicio y expresion_artistica empatadas arriba: el teatro y el servicio
;   publico son dos senas de identidad simultaneas de la escuela.

[resource]
script = ExtResource("1_uni")
id = &"yale"
nombre_display = "Yale University"
color_primario = Color(0.05, 0.22, 0.5, 1)
