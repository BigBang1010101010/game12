[ext_resource type="Script" path="res://scripts/resources/university_data.gd" id="1_uni"]

; RAZONAMIENTO DE PESOS - Brown
; - curiosidad_intelectual 1.0, por encima del rigor academico, y ademas
;   umbral (40): con Open Curriculum, un estudiante sin direccion propia se
;   hunde. Es literalmente el rasgo que la escuela necesita.
; - afinidad con curiosidad_autodidacta 1.45, empatada como la mas alta del
;   dataset junto al emprendimiento en Penn, y por la misma logica: es el
;   rasgo que define a la institucion.
; - liderazgo 0.5, el mas bajo de las ocho: aqui no se premia dirigir, se
;   premia explorar.
; - umbral de rigor 60, el mas bajo, coherente con su fama de flexibilidad.

[resource]
script = ExtResource("1_uni")
id = &"brown"
nombre_display = "Brown University"
