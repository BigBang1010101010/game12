[ext_resource type="Script" path="res://scripts/resources/university_data.gd" id="1_uni"]

; RAZONAMIENTO DE PESOS - Cornell
; - el perfil deliberadamente MAS PLANO de las ocho: ninguna afinidad baja de
;   1.05 y ninguna pasa de 1.25. Con siete colegios distintos y la tasa de
;   admision mas alta (7.5%), no hay un unico arquetipo que buscar.
; - aptitud_cientifica 0.75, la mas alta del grupo, por el peso de ingenieria
;   y de las ciencias aplicadas en su mezcla de programas.
; - un solo umbral y relativamente bajo: es la mas accesible para un perfil
;   fuerte pero no extraordinario, que es exactamente lo que la reputa.

[resource]
script = ExtResource("1_uni")
id = &"cornell"
nombre_display = "Cornell University"
color_primario = Color(0.70, 0.11, 0.11, 1)
