&"rigor_academico": 0.9,
&"resiliencia": 0.9,
&"profundidad_extracurricular": 0.95,
&"logro_atletico": 0.7,
&"liderazgo": 0.7,
&"impacto_comunitario": 0.6,
&"red_social": 0.55,
&"curiosidad_intelectual": 0.55,
&"bienestar": 0.35
}
