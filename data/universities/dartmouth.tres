[ext_resource type="Script" path="res://scripts/resources/university_data.gd" id="1_uni"]

; RAZONAMIENTO DE PESOS - Dartmouth
; - profundidad_extracurricular 0.95 por encima del propio rigor academico, y
;   ademas umbral (35): el aislamiento rural hace que la vida fuera del aula
;   SEA la escuela. Un perfil solo academico encaja mal aqui.
; - resiliencia 0.9, la mas alta de las ocho, y logro_atletico 0.7, tambien la
;   mas alta: inviernos duros, D1 con cuerpo estudiantil pequeno.
; - unica escuela que pondera bienestar (0.35), por la misma razon.
; - umbral de rigor 62, el mas bajo del grupo: compensa mejor que las demas un
;   expediente algo menor con una trayectoria extracurricular profunda.

[resource]
script = ExtResource("1_uni")
id = &"dartmouth"
nombre_display = "Dartmouth College"
color_primario = Color(0.0, 0.42, 0.24, 1)
color_secundario = Color(0.95, 0.95, 0.95, 1)
