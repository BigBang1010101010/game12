[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 1: la robótica competitiva tiene un circuito nacional real (FIRST), asi que un titulo ahi se lee como logro nacional verificable.
;   Paga aptitud cuantitativa y cientifica porque el trabajo es diseno e iteracion medible, y profundidad extracurricular porque exige temporada completa.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Miembro del equipo"
tier = 4
modificadores_atributo = {
&"aptitud_cuantitativa": 4.00,
&"profundidad_extracurricular": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Subsistema propio"
tier = 3
modificadores_atributo = {
&"aptitud_cientifica": 5.00,
&"gestion_tiempo": 3.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Líder técnico"
tier = 2
modificadores_atributo = {
&"aptitud_cuantitativa": 7.00,
&"liderazgo": 5.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Campeón nacional"
tier = 1
modificadores_atributo = {
&"aptitud_cientifica": 11.00,
&"profundidad_extracurricular": 9.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "rol_liderazgo",
"valor": &"presidente"
}, {
"palanca": "reconocimiento_externo",
"valor": &"estatal"
}, {
"palanca": "impacto_medible",
"valor": 400.0
}]

[resource]
script = ExtResource("1_act")
id = &"robotica_competitiva"
nombre_display = "Robótica competitiva"
descripcion = "Equipo de robótica que compite en torneos regionales y nacionales."
categoria = &"stem"
tier_techo = 1
costo_horas_semana = 10
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"ingenieria": 1.45,
&"ciencias_computacion": 1.35,
&"economia": 1.05
}
