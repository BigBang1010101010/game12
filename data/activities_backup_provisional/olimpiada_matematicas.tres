[gd_resource type="Resource" script_class="ActivityData" load_steps=7 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 1: la olimpiada tiene una jerarquia nacional inequivoca y es de las pocas credenciales que una oficina de admisiones puede leer sin contexto.
;   Paga casi todo en aptitud cuantitativa: es lo que mide.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Club de olimpiada"
tier = 4
modificadores_atributo = {
&"aptitud_cuantitativa": 5.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Selectivo escolar"
tier = 3
modificadores_atributo = {
&"aptitud_cuantitativa": 6.00,
&"rigor_academico": 3.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Medalla regional"
tier = 2
modificadores_atributo = {
&"aptitud_cuantitativa": 8.00,
&"curiosidad_intelectual": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[sub_resource type="Resource" id="Nivel3"]
script = ExtResource("2_niv")
nombre = "Selección nacional"
tier = 1
modificadores_atributo = {
&"aptitud_cuantitativa": 12.00,
&"rigor_academico": 7.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 3.0
}, {
"palanca": "rol_liderazgo",
"valor": &"presidente"
}, {
"palanca": "reconocimiento_externo",
"valor": &"estatal"
}, {
"palanca": "impacto_medible",
"valor": 400.0
}]

[resource]
script = ExtResource("1_act")
id = &"olimpiada_matematicas"
nombre_display = "Olimpiada de matemáticas"
descripcion = "Entrenamiento y competencia en olimpiadas matemáticas."
categoria = &"stem"
tier_techo = 1
costo_horas_semana = 8
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2"), SubResource("Nivel3")]
carreras_afinidad = {
&"ciencias_computacion": 1.35,
&"economia": 1.30,
&"ingenieria": 1.30,
&"finanzas": 1.20
}
