[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 2: exige muchisimo tiempo y ensena presencia, pero el circuito competitivo es local; su valor real es la profundidad sostenida.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Reparto"
tier = 4
modificadores_atributo = {
&"habilidad_artistica": 4.00,
&"red_social": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Papel principal"
tier = 3
modificadores_atributo = {
&"habilidad_artistica": 5.00,
&"resiliencia": 4.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Dirección"
tier = 2
modificadores_atributo = {
&"habilidad_artistica": 7.00,
&"liderazgo": 5.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[resource]
script = ExtResource("1_act")
id = &"teatro"
nombre_display = "Teatro"
descripcion = "Producciones escolares y compañías juveniles."
categoria = &"artes"
tier_techo = 2
costo_horas_semana = 8
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"artes_comunicacion": 1.45,
&"psicologia": 1.10
}
