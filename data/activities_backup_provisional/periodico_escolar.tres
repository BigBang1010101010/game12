[gd_resource type="Resource" script_class="ActivityData" load_steps=6 format=3]

[ext_resource type="Script" path="res://scripts/resources/activity_data.gd" id="1_act"]
[ext_resource type="Script" path="res://scripts/resources/activity_level.gd" id="2_niv"]

; RAZONAMIENTO
;   Tier techo 2: la jefatura de redaccion es un cargo real con producto publicado cada mes, lo que la vuelve una de las actividades escolares mas legibles; aun asi rara vez sale del ambito escolar.

[sub_resource type="Resource" id="Nivel0"]
script = ExtResource("2_niv")
nombre = "Reportero"
tier = 4
modificadores_atributo = {
&"aptitud_verbal": 4.00,
&"curiosidad_intelectual": 3.00
}
condiciones_ascenso = []

[sub_resource type="Resource" id="Nivel1"]
script = ExtResource("2_niv")
nombre = "Editor de sección"
tier = 3
modificadores_atributo = {
&"aptitud_verbal": 5.00,
&"gestion_tiempo": 3.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 1.0
}, {
"palanca": "rol_liderazgo",
"valor": &"miembro"
}]

[sub_resource type="Resource" id="Nivel2"]
script = ExtResource("2_niv")
nombre = "Jefe de redacción"
tier = 2
modificadores_atributo = {
&"aptitud_verbal": 7.00,
&"liderazgo": 5.00
}
condiciones_ascenso = [{
"palanca": "anios_continuidad",
"valor": 2.0
}, {
"palanca": "rol_liderazgo",
"valor": &"oficial"
}, {
"palanca": "reconocimiento_externo",
"valor": &"escolar"
}]

[resource]
script = ExtResource("1_act")
id = &"periodico_escolar"
nombre_display = "Periódico escolar"
descripcion = "Redacción, investigación y edición del periódico del colegio."
categoria = &"artes"
tier_techo = 2
costo_horas_semana = 6
niveles = [SubResource("Nivel0"), SubResource("Nivel1"), SubResource("Nivel2")]
carreras_afinidad = {
&"artes_comunicacion": 1.40,
&"ciencias_politicas": 1.15,
&"derecho": 1.15
}
