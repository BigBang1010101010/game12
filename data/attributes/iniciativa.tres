[gd_resource type="Resource" script_class="AttributeDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/attribute_definition.gd" id="1_def"]

; Creado para el catalogo definitivo: lo paga el podcast/audiovisual y, en
; general, todo lo que existe solo porque alguien decidio empezarlo. Se
; distingue de liderazgo a proposito: liderazgo es coordinar gente, iniciativa
; es arrancar sin permiso ni estructura.
[resource]
script = ExtResource("1_def")
id = &"iniciativa"
nombre_display = "Iniciativa"
descripcion = "Tu tendencia a empezar cosas que nadie te pidió: proyectos propios, publicaciones, organizaciones que antes no existían."
categoria = &"holistico"
valor_inicial = 0.0
valor_maximo = 100.0
tasa_decaimiento = 0.0
curva_exponente = 1.0
