[gd_resource type="Resource" script_class="AttributeDefinition" load_steps=2 format=3]

[ext_resource type="Script" path="res://scripts/resources/attribute_definition.gd" id="1_def"]

; Creado para el catalogo definitivo de actividades, que paga "caracter" en el
; voluntariado sostenido y en el hospitalario. Es lo que las cartas de
; recomendacion describen y ningun examen mide: como te comportas cuando nadie
; lleva la cuenta. No decae, y tiene la curva mas plana de todas porque no se
; entrena a base de horas.
[resource]
script = ExtResource("1_def")
id = &"caracter"
nombre_display = "Carácter"
descripcion = "Lo que dicen de ti quienes te vieron trabajar: constancia, honestidad y cómo tratas a la gente cuando no hay nada que ganar."
categoria = &"holistico"
valor_inicial = 0.0
valor_maximo = 100.0
tasa_decaimiento = 0.0
curva_exponente = 0.9
