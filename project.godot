toggle_inventory={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":73,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}
sleep={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":90,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

; sprint: Left Ctrl is the primary binding, plus Q as a second binding -
; in the Web export Ctrl+W is a browser shortcut that closes the tab and W
; is "move_forward", so sprinting forward on Ctrl alone would kill the game.
; toggle_activities: T de "tiempo". Libre en el mapa de teclas (E interactuar,
; I inventario, Z dormir, Ctrl/Q correr, F1 laboratorio) y sin conflicto con
; atajos del navegador en la exportacion Web.
toggle_activities={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":84,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)
]
}

sprint={
"deadzone": 0.5,
"events": [Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":4194326,"key_label":0,"unicode":0,"location":1,"echo":false,"script":null), Object(InputEventKey,"resource_local_to_scene":false,"resource_name":"","device":-1,"window_id":0,"alt_pressed":false,"shift_pressed":false,"ctrl_pressed":false,"meta_pressed":false,"pressed":false,"keycode":0,"physical_keycode":81,"key_label":0,"unicode":0,"location":0,"echo":false,"script":null)]
}

[autoload]

; Order matters: PlayerState connects to DayNightCycle's day_passed signal in
; _ready(), and the registries must exist before PlayerState builds its value
; table from them, so those all come first.
DayNightCycle="*res://scripts/day_night_cycle.gd"
EventBus="*res://scripts/progression/event_bus.gd"
AttributeRegistry="*res://scripts/registries/attribute_registry.gd"
SynergyRegistry="*res://scripts/registries/synergy_registry.gd"
ModifierEngine="*res://scripts/progression/modifier_engine.gd"
PlayerState="*res://scripts/progression/player_state.gd"
UniversityRegistry="*res://scripts/registries/university_registry.gd"
CareerRegistry="*res://scripts/registries/career_registry.gd"
EssayRegistry="*res://scripts/registries/essay_registry.gd"
ActivityRegistry="*res://scripts/registries/activity_registry.gd"
LocationRegistry="*res://scripts/registries/location_registry.gd"
ParentRegistry="*res://scripts/registries/parent_registry.gd"
GiftRegistry="*res://scripts/registries/gift_registry.gd"
SpendingRegistry="*res://scripts/registries/spending_registry.gd"
ConsultingRegistry="*res://scripts/registries/consulting_registry.gd"
SportStatRegistry="*res://scripts/registries/sport_stat_registry.gd"
StatBenchmarkRegistry="*res://scripts/registries/stat_benchmark_registry.gd"
AdmissionCalculator="*res://scripts/progression/admission_calculator.gd"
; AcademicIndex reads the config that AdmissionCalculator owns, and
; ActivityTracker asks AcademicIndex whether an athlete is recruitable,
; so the three come in that order.
AcademicIndex="*res://scripts/progression/academic_index.gd"
; Las estadisticas deportivas van antes que ActivityTracker: de ellas deriva el
; reconocimiento que las escaleras de los deportes leen.
SportStatsTracker="*res://scripts/progression/sport_stats_tracker.gd"
ActivityTracker="*res://scripts/progression/activity_tracker.gd"
; TimeBudget charges burnout through PlayerState and reads the activities
; the tracker holds, so it comes after both.
TimeBudget="*res://scripts/progression/time_budget.gd"
ApplicationBuilder="*res://scripts/progression/application_builder.gd"
SaveSystem="*res://scripts/progression/save_system.gd"
; PlayerOrigin persiste su eleccion a traves de SaveSystem, asi que va detras.
PlayerOrigin="*res://scripts/progression/player_origin.gd"
; FamilyRelationship escribe en el ledger de PlayerState y se engancha al
; ciclo dia/noche, asi que llega despues de ambos.
FamilyRelationship="*res://scripts/progression/family_relationship.gd"
; El dinero llega despues del origen (que siembra el bolsillo familiar) y de
; PlayerState (que audita cada movimiento); el credito, despues del dinero y
; de la relacion familiar, que son sus dos entradas.
Wallet="*res://scripts/progression/wallet.gd"
FamilyCredit="*res://scripts/progression/family_credit.gd"
InfoPolicy="*res://scripts/progression/information_policy.gd"
ConsultingService="*res://scripts/progression/consulting_service.gd"
; La pantalla de actividades necesita HUD para esconderlo, asi que va al final.
AdmissionsLab="*res://scripts/debug/admissions_lab_toggle.gd"
Inventory="*res://scripts/inventory.gd"
PlayerStats="*res://scripts/player_stats.gd"
InteractionUI="*res://scripts/interaction_ui.gd"
InventoryUI="*res://scripts/inventory_ui.gd"
HUD="*res://scripts/hud.gd"
SleepController="*res://scripts/sleep_controller.gd"
ActivitiesScreen="*res://scripts/ui/activities_ui_toggle.gd"
GiftShopScreen="*res://scripts/ui/gift_shop_screen.gd"

[rendering]

renderer/rendering_method="mobile"
renderer/rendering_method.mobile="mobile"
